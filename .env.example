# ClassConnect AI - Environment Configuration Example
# All APIs used in this project have 100% FREE tiers (Google Gemini Free Tier, Neon/Supabase Free Tier)

# Database URL (PostgreSQL - Neon / Supabase / Railway Free Tier / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classconnect?schema=public"

# App URL (Production: https://class-connect-ai.vercel.app / Local: http://localhost:3000)
NEXT_PUBLIC_APP_URL="https://class-connect-ai.vercel.app"

# AI Configuration: Google Gemini API (100% FREE tier at https://aistudio.google.com/)
# Free tier gives 15 requests/min & 1,500 requests/day at zero cost with no credit card required.
# In local development, built-in intelligent fallback responses work even with no API key set!
GEMINI_API_KEY=""

# Optional Authentication (Clerk Free Tier / Built-in Role Switcher)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
